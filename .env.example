# ===== Application =====
# "development" skips rate limiting; use "production" on the server
ENVIRONMENT=production
DEBUG=false
# The public origin allowed for CORS (your domain in production)
ALLOWED_ORIGIN=https://yourdomain.com

# ===== Groq LLM (required) =====
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT=30

# ===== Qdrant Vector Database =====
# Host is the docker service name when running via docker compose
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=portfolio

# ===== SearXNG Web Search =====
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT=10

# ===== Brevo Email (contact form) =====
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_RECIPIENT_EMAIL=kulbhushan.saxena09@gmail.com

# ===== Embedding Model =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=5

# ===== Security (admin_api_key required) =====
# Used to authorize the /api/ingest endpoint
ADMIN_API_KEY=your-strong-admin-secret-here
MAX_REQUEST_SIZE=10240
RATE_LIMIT_CHAT=30
RATE_LIMIT_CONTACT=5

# ===== Conversation Memory =====
MAX_CONVERSATION_TURNS=10
SESSION_TTL_MINUTES=30
MAX_SESSIONS=1000

# ===== Circuit Breaker =====
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60

# ===== RAG =====
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.35

# ===== Performance =====
MAX_CONCURRENT_STREAMS=50
REQUEST_TIMEOUT=60

# ===== Cloudflare Tunnel (used by docker-compose) =====
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
